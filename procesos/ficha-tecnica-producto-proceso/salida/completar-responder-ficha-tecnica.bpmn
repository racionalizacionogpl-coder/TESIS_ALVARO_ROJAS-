<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FichaTecnica" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Generador propio (validado con bpmnlint y bpmn-js)" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_FichaTecnica">
    <bpmn:participant id="Participant_FichaTecnica" name="Completar y responder la Ficha Técnica de Producto y Proceso" processRef="Process_FichaTecnica" />
  </bpmn:collaboration>
  <bpmn:process id="Process_FichaTecnica" name="Completar y responder la Ficha Técnica de Producto y Proceso" isExecutable="false">
    <bpmn:laneSet id="LaneSet_FichaTecnica">
      <bpmn:lane id="Lane_JefeUPPR" name="Jefe de la UPPR (responsable del proceso)">
        <bpmn:flowNodeRef>StartEvent_Main</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_FaseA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_FaseB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Main</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Main" name="Ficha técnica por verificar">
      <bpmn:outgoing>Flow_Main_s_A</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_FaseA" name="A. Verificar descripción">
      <bpmn:documentation>Verificar las columnas de la sección “Descripción del proceso” de la ficha técnica: entradas, proveedores, salidas y beneficiarios (pasos 1 a 4 de la guía).</bpmn:documentation>
      <bpmn:incoming>Flow_Main_s_A</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_A_B</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_FaseA" name="Descripción del proceso por verificar">
        <bpmn:outgoing>Flow_FaseA_to_V1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:subProcess id="SubProcess_V1" name="1. Verificar entradas">
        <bpmn:documentation>Subproceso que se repite por cada fila de la ficha (multi-instancia secuencial). Al terminar todas las filas continúa con 2. Verificar proveedores.</bpmn:documentation>
        <bpmn:incoming>Flow_FaseA_to_V1</bpmn:incoming>
        <bpmn:outgoing>Flow_FaseA_to_V2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics id="MI_SubProcess_V1" isSequential="true" />
        <bpmn:startEvent id="StartEvent_V1" name="Entrada por verificar">
          <bpmn:outgoing>Flow_V1_s_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_1_1" name="1.1 Revisar entrada en la ficha técnica">
          <bpmn:documentation>Revisar en la columna “Entradas” de la ficha técnica el documento indicado y verificar si corresponde a la versión vigente del instrumento normativo, metodológico o de gestión que utiliza actualmente para el desarrollo de sus funciones y actividades.</bpmn:documentation>
          <bpmn:incoming>Flow_V1_s_1</bpmn:incoming>
          <bpmn:outgoing>Flow_V1_1_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_1_2" name="1.2 ¿Corresponde al instrumento vigente?">
          <bpmn:documentation>¿El documento recibido corresponde a la versión vigente del instrumento normativo, metodológico o de gestión que utiliza actualmente?</bpmn:documentation>
          <bpmn:incoming>Flow_V1_1_2</bpmn:incoming>
          <bpmn:outgoing>Flow_V1_2_3</bpmn:outgoing>
          <bpmn:outgoing>Flow_V1_2_4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_1_3" name="1.3 Marcar casilla SÍ">
          <bpmn:documentation>Marcar la casilla SÍ de la fila: el documento recibido corresponde al instrumento que utiliza actualmente.</bpmn:documentation>
          <bpmn:incoming>Flow_V1_2_3</bpmn:incoming>
          <bpmn:outgoing>Flow_V1_3_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_1_4" name="1.4 Marcar casilla NO">
          <bpmn:documentation>Marcar la casilla NO de la fila cuando se trate de otro documento, tenga una denominación diferente o no se encuentre vigente.</bpmn:documentation>
          <bpmn:incoming>Flow_V1_2_4</bpmn:incoming>
          <bpmn:outgoing>Flow_V1_4_5</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_1_5" name="1.5 Registrar nombre correcto de la entrada">
          <bpmn:documentation>Registrar en la columna “Nombre correcto de las entradas” la denominación actual y correcta del instrumento que utiliza.</bpmn:documentation>
          <bpmn:incoming>Flow_V1_4_5</bpmn:incoming>
          <bpmn:outgoing>Flow_V1_5_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_1_merge">
          <bpmn:incoming>Flow_V1_3_m</bpmn:incoming>
          <bpmn:incoming>Flow_V1_5_m</bpmn:incoming>
          <bpmn:outgoing>Flow_V1_m_e</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_V1" name="Entrada verificada">
          <bpmn:incoming>Flow_V1_m_e</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_V1_s_1" sourceRef="StartEvent_V1" targetRef="Task_1_1" />
        <bpmn:sequenceFlow id="Flow_V1_1_2" sourceRef="Task_1_1" targetRef="Gateway_1_2" />
        <bpmn:sequenceFlow id="Flow_V1_2_3" name="Sí" sourceRef="Gateway_1_2" targetRef="Task_1_3" />
        <bpmn:sequenceFlow id="Flow_V1_2_4" name="No" sourceRef="Gateway_1_2" targetRef="Task_1_4" />
        <bpmn:sequenceFlow id="Flow_V1_4_5" sourceRef="Task_1_4" targetRef="Task_1_5" />
        <bpmn:sequenceFlow id="Flow_V1_3_m" sourceRef="Task_1_3" targetRef="Gateway_1_merge" />
        <bpmn:sequenceFlow id="Flow_V1_5_m" sourceRef="Task_1_5" targetRef="Gateway_1_merge" />
        <bpmn:sequenceFlow id="Flow_V1_m_e" sourceRef="Gateway_1_merge" targetRef="EndEvent_V1" />
      </bpmn:subProcess>
      <bpmn:subProcess id="SubProcess_V2" name="2. Verificar proveedores">
        <bpmn:documentation>Subproceso que se repite por cada fila de la ficha (multi-instancia secuencial). Al terminar todas las filas continúa con 3. Verificar salidas.</bpmn:documentation>
        <bpmn:incoming>Flow_FaseA_to_V2</bpmn:incoming>
        <bpmn:outgoing>Flow_FaseA_to_V3</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics id="MI_SubProcess_V2" isSequential="true" />
        <bpmn:startEvent id="StartEvent_V2" name="Proveedor por verificar">
          <bpmn:outgoing>Flow_V2_s_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_2_1" name="2.1 Revisar proveedor en la ficha técnica">
          <bpmn:documentation>Revisar en la columna “Proveedores” la oficina o unidad indicada y verificar si es la que actualmente entrega, remite o envía el documento señalado en la columna “Entradas”.</bpmn:documentation>
          <bpmn:incoming>Flow_V2_s_1</bpmn:incoming>
          <bpmn:outgoing>Flow_V2_1_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_2_2" name="2.2 ¿Es la oficina que entrega actualmente el documento?">
          <bpmn:documentation>¿La oficina o unidad indicada en “Proveedores” es la que actualmente entrega, remite o envía el documento señalado en “Entradas”?</bpmn:documentation>
          <bpmn:incoming>Flow_V2_1_2</bpmn:incoming>
          <bpmn:outgoing>Flow_V2_2_3</bpmn:outgoing>
          <bpmn:outgoing>Flow_V2_2_4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_2_3" name="2.3 Marcar casilla SÍ">
          <bpmn:documentation>Marcar la casilla SÍ de la fila: la oficina o unidad indicada es la que actualmente entrega, remite o envía el documento.</bpmn:documentation>
          <bpmn:incoming>Flow_V2_2_3</bpmn:incoming>
          <bpmn:outgoing>Flow_V2_3_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_2_4" name="2.4 Marcar casilla NO">
          <bpmn:documentation>Marcar la casilla NO de la fila cuando se trate de otra oficina o unidad, tenga una denominación diferente o no sea la responsable actualmente.</bpmn:documentation>
          <bpmn:incoming>Flow_V2_2_4</bpmn:incoming>
          <bpmn:outgoing>Flow_V2_4_5</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_2_5" name="2.5 Registrar nombre correcto del proveedor">
          <bpmn:documentation>Registrar en la columna “Nombre correcto del proveedor” la denominación actual y correcta de la oficina o unidad que entrega, remite o envía el documento.</bpmn:documentation>
          <bpmn:incoming>Flow_V2_4_5</bpmn:incoming>
          <bpmn:outgoing>Flow_V2_5_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_2_merge">
          <bpmn:incoming>Flow_V2_3_m</bpmn:incoming>
          <bpmn:incoming>Flow_V2_5_m</bpmn:incoming>
          <bpmn:outgoing>Flow_V2_m_e</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_V2" name="Proveedor verificado">
          <bpmn:incoming>Flow_V2_m_e</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_V2_s_1" sourceRef="StartEvent_V2" targetRef="Task_2_1" />
        <bpmn:sequenceFlow id="Flow_V2_1_2" sourceRef="Task_2_1" targetRef="Gateway_2_2" />
        <bpmn:sequenceFlow id="Flow_V2_2_3" name="Sí" sourceRef="Gateway_2_2" targetRef="Task_2_3" />
        <bpmn:sequenceFlow id="Flow_V2_2_4" name="No" sourceRef="Gateway_2_2" targetRef="Task_2_4" />
        <bpmn:sequenceFlow id="Flow_V2_4_5" sourceRef="Task_2_4" targetRef="Task_2_5" />
        <bpmn:sequenceFlow id="Flow_V2_3_m" sourceRef="Task_2_3" targetRef="Gateway_2_merge" />
        <bpmn:sequenceFlow id="Flow_V2_5_m" sourceRef="Task_2_5" targetRef="Gateway_2_merge" />
        <bpmn:sequenceFlow id="Flow_V2_m_e" sourceRef="Gateway_2_merge" targetRef="EndEvent_V2" />
      </bpmn:subProcess>
      <bpmn:subProcess id="SubProcess_V3" name="3. Verificar salidas">
        <bpmn:documentation>Subproceso que se repite por cada fila de la ficha (multi-instancia secuencial). Al terminar todas las filas continúa con 4. Verificar beneficiarios.</bpmn:documentation>
        <bpmn:incoming>Flow_FaseA_to_V3</bpmn:incoming>
        <bpmn:outgoing>Flow_FaseA_to_V4</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics id="MI_SubProcess_V3" isSequential="true" />
        <bpmn:startEvent id="StartEvent_V3" name="Salida por verificar">
          <bpmn:outgoing>Flow_V3_s_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_3_1" name="3.1 Revisar salida en la ficha técnica">
          <bpmn:documentation>Revisar en la columna “Salidas” el documento o producto indicado y verificar si es el que actualmente elabora, genera o entrega como resultado de sus funciones.</bpmn:documentation>
          <bpmn:incoming>Flow_V3_s_1</bpmn:incoming>
          <bpmn:outgoing>Flow_V3_1_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_3_2" name="3.2 ¿Es el producto que elabora actualmente?">
          <bpmn:documentation>¿El documento o producto indicado en “Salidas” es el que actualmente elabora, genera o entrega?</bpmn:documentation>
          <bpmn:incoming>Flow_V3_1_2</bpmn:incoming>
          <bpmn:outgoing>Flow_V3_2_3</bpmn:outgoing>
          <bpmn:outgoing>Flow_V3_2_4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_3_3" name="3.3 Marcar casilla SÍ">
          <bpmn:documentation>Marcar la casilla SÍ de la fila: es el documento o producto que actualmente elabora, genera o entrega.</bpmn:documentation>
          <bpmn:incoming>Flow_V3_2_3</bpmn:incoming>
          <bpmn:outgoing>Flow_V3_3_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_3_4" name="3.4 Marcar casilla NO">
          <bpmn:documentation>Marcar la casilla NO de la fila cuando se trate de otro documento o producto, tenga una denominación diferente o no sea elaborado actualmente.</bpmn:documentation>
          <bpmn:incoming>Flow_V3_2_4</bpmn:incoming>
          <bpmn:outgoing>Flow_V3_4_5</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_3_5" name="3.5 Registrar nombre correcto de la salida">
          <bpmn:documentation>Registrar en la columna “Nombre correcto de las salidas” la denominación actual y correcta del documento o producto que elabora, genera o entrega.</bpmn:documentation>
          <bpmn:incoming>Flow_V3_4_5</bpmn:incoming>
          <bpmn:outgoing>Flow_V3_5_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_3_merge">
          <bpmn:incoming>Flow_V3_3_m</bpmn:incoming>
          <bpmn:incoming>Flow_V3_5_m</bpmn:incoming>
          <bpmn:outgoing>Flow_V3_m_e</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_V3" name="Salida verificada">
          <bpmn:incoming>Flow_V3_m_e</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_V3_s_1" sourceRef="StartEvent_V3" targetRef="Task_3_1" />
        <bpmn:sequenceFlow id="Flow_V3_1_2" sourceRef="Task_3_1" targetRef="Gateway_3_2" />
        <bpmn:sequenceFlow id="Flow_V3_2_3" name="Sí" sourceRef="Gateway_3_2" targetRef="Task_3_3" />
        <bpmn:sequenceFlow id="Flow_V3_2_4" name="No" sourceRef="Gateway_3_2" targetRef="Task_3_4" />
        <bpmn:sequenceFlow id="Flow_V3_4_5" sourceRef="Task_3_4" targetRef="Task_3_5" />
        <bpmn:sequenceFlow id="Flow_V3_3_m" sourceRef="Task_3_3" targetRef="Gateway_3_merge" />
        <bpmn:sequenceFlow id="Flow_V3_5_m" sourceRef="Task_3_5" targetRef="Gateway_3_merge" />
        <bpmn:sequenceFlow id="Flow_V3_m_e" sourceRef="Gateway_3_merge" targetRef="EndEvent_V3" />
      </bpmn:subProcess>
      <bpmn:subProcess id="SubProcess_V4" name="4. Verificar beneficiarios">
        <bpmn:documentation>Subproceso que se repite por cada fila de la ficha (multi-instancia secuencial). Al terminar todas las filas continúa con 5. Verificar recursos.</bpmn:documentation>
        <bpmn:incoming>Flow_FaseA_to_V4</bpmn:incoming>
        <bpmn:outgoing>Flow_FaseA_end</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics id="MI_SubProcess_V4" isSequential="true" />
        <bpmn:startEvent id="StartEvent_V4" name="Beneficiario por verificar">
          <bpmn:outgoing>Flow_V4_s_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_4_1" name="4.1 Revisar beneficiario en la ficha técnica">
          <bpmn:documentation>Revisar en la columna “Beneficiarios” la entidad, oficina, unidad o persona indicada y verificar si es quien actualmente recibe el documento o producto señalado en la columna “Salidas”.</bpmn:documentation>
          <bpmn:incoming>Flow_V4_s_1</bpmn:incoming>
          <bpmn:outgoing>Flow_V4_1_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_4_2" name="4.2 ¿Es quien recibe actualmente la salida?">
          <bpmn:documentation>¿El documento o producto indicado en “Salidas” es recibido actualmente por la entidad, oficina, unidad o persona indicada en “Beneficiarios”?</bpmn:documentation>
          <bpmn:incoming>Flow_V4_1_2</bpmn:incoming>
          <bpmn:outgoing>Flow_V4_2_3</bpmn:outgoing>
          <bpmn:outgoing>Flow_V4_2_4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_4_3" name="4.3 Marcar casilla SÍ">
          <bpmn:documentation>Marcar la casilla SÍ de la fila: el beneficiario indicado es quien actualmente recibe el documento o producto.</bpmn:documentation>
          <bpmn:incoming>Flow_V4_2_3</bpmn:incoming>
          <bpmn:outgoing>Flow_V4_3_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_4_4" name="4.4 Marcar casilla NO">
          <bpmn:documentation>Marcar la casilla NO de la fila cuando se trate de otra entidad, oficina, unidad o persona, tenga una denominación diferente o no sea quien actualmente recibe el documento o producto.</bpmn:documentation>
          <bpmn:incoming>Flow_V4_2_4</bpmn:incoming>
          <bpmn:outgoing>Flow_V4_4_5</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_4_5" name="4.5 Registrar nombre correcto del beneficiario">
          <bpmn:documentation>Registrar en la columna “Nombre correcto de beneficiarios” la denominación actual y correcta.</bpmn:documentation>
          <bpmn:incoming>Flow_V4_4_5</bpmn:incoming>
          <bpmn:outgoing>Flow_V4_5_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_4_merge">
          <bpmn:incoming>Flow_V4_3_m</bpmn:incoming>
          <bpmn:incoming>Flow_V4_5_m</bpmn:incoming>
          <bpmn:outgoing>Flow_V4_m_e</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_V4" name="Beneficiario verificado">
          <bpmn:incoming>Flow_V4_m_e</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_V4_s_1" sourceRef="StartEvent_V4" targetRef="Task_4_1" />
        <bpmn:sequenceFlow id="Flow_V4_1_2" sourceRef="Task_4_1" targetRef="Gateway_4_2" />
        <bpmn:sequenceFlow id="Flow_V4_2_3" name="Sí" sourceRef="Gateway_4_2" targetRef="Task_4_3" />
        <bpmn:sequenceFlow id="Flow_V4_2_4" name="No" sourceRef="Gateway_4_2" targetRef="Task_4_4" />
        <bpmn:sequenceFlow id="Flow_V4_4_5" sourceRef="Task_4_4" targetRef="Task_4_5" />
        <bpmn:sequenceFlow id="Flow_V4_3_m" sourceRef="Task_4_3" targetRef="Gateway_4_merge" />
        <bpmn:sequenceFlow id="Flow_V4_5_m" sourceRef="Task_4_5" targetRef="Gateway_4_merge" />
        <bpmn:sequenceFlow id="Flow_V4_m_e" sourceRef="Gateway_4_merge" targetRef="EndEvent_V4" />
      </bpmn:subProcess>
      <bpmn:endEvent id="EndEvent_FaseA" name="Descripción del proceso verificada">
        <bpmn:incoming>Flow_FaseA_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_FaseA_to_V1" sourceRef="StartEvent_FaseA" targetRef="SubProcess_V1" />
      <bpmn:sequenceFlow id="Flow_FaseA_to_V2" sourceRef="SubProcess_V1" targetRef="SubProcess_V2" />
      <bpmn:sequenceFlow id="Flow_FaseA_to_V3" sourceRef="SubProcess_V2" targetRef="SubProcess_V3" />
      <bpmn:sequenceFlow id="Flow_FaseA_to_V4" sourceRef="SubProcess_V3" targetRef="SubProcess_V4" />
      <bpmn:sequenceFlow id="Flow_FaseA_end" sourceRef="SubProcess_V4" targetRef="EndEvent_FaseA" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_FaseB" name="B. Verificar ejecución">
      <bpmn:documentation>Verificar la sección “Ejecución del proceso” de la ficha técnica: recursos, registros, riesgos y controles (pasos 5 a 8 de la guía).</bpmn:documentation>
      <bpmn:incoming>Flow_Main_A_B</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_B_9</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_FaseB" name="Ejecución del proceso por verificar">
        <bpmn:outgoing>Flow_FaseB_to_V5</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:subProcess id="SubProcess_V5" name="5. Verificar recursos">
        <bpmn:documentation>Subproceso que se repite por cada fila de la ficha (multi-instancia secuencial). Al terminar todas las filas continúa con 6. Verificar registros.</bpmn:documentation>
        <bpmn:incoming>Flow_FaseB_to_V5</bpmn:incoming>
        <bpmn:outgoing>Flow_FaseB_to_V6</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics id="MI_SubProcess_V5" isSequential="true" />
        <bpmn:startEvent id="StartEvent_V5" name="Recurso por verificar">
          <bpmn:outgoing>Flow_V5_s_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_5_1" name="5.1 Revisar recurso en la ficha técnica">
          <bpmn:documentation>Revisar en la sección “Recursos” los recursos indicados (humanos, físicos, equipos tecnológicos y sistemas informáticos) y verificar si corresponden a los que actualmente tiene la oficina o unidad para el desarrollo de sus funciones, considerando su tipo y cantidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V5_s_1</bpmn:incoming>
          <bpmn:outgoing>Flow_V5_1_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_5_2" name="5.2 ¿Corresponden en tipo y cantidad?">
          <bpmn:documentation>¿Los recursos indicados en la ficha son los que actualmente tiene la oficina o unidad para desarrollar sus funciones, considerando su tipo y cantidad?</bpmn:documentation>
          <bpmn:incoming>Flow_V5_1_2</bpmn:incoming>
          <bpmn:outgoing>Flow_V5_2_3</bpmn:outgoing>
          <bpmn:outgoing>Flow_V5_2_4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_5_3" name="5.3 Marcar casilla SÍ">
          <bpmn:documentation>Marcar la casilla SÍ de la fila: los recursos indicados corresponden a los que actualmente tiene la oficina o unidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V5_2_3</bpmn:incoming>
          <bpmn:outgoing>Flow_V5_3_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_5_4" name="5.4 Marcar casilla NO">
          <bpmn:documentation>Marcar la casilla NO de la fila cuando falte algún recurso, haya recursos adicionales, la cantidad sea diferente o la denominación sea distinta.</bpmn:documentation>
          <bpmn:incoming>Flow_V5_2_4</bpmn:incoming>
          <bpmn:outgoing>Flow_V5_4_5</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_5_5" name="5.5 Registrar detalle correcto de los recursos">
          <bpmn:documentation>Registrar en la columna “Nombre correcto” el detalle actual y correcto de los recursos con los que cuenta, indicando la cantidad y/o denominación correcta.</bpmn:documentation>
          <bpmn:incoming>Flow_V5_4_5</bpmn:incoming>
          <bpmn:outgoing>Flow_V5_5_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_5_merge">
          <bpmn:incoming>Flow_V5_3_m</bpmn:incoming>
          <bpmn:incoming>Flow_V5_5_m</bpmn:incoming>
          <bpmn:outgoing>Flow_V5_m_e</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_V5" name="Recurso verificado">
          <bpmn:incoming>Flow_V5_m_e</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_V5_s_1" sourceRef="StartEvent_V5" targetRef="Task_5_1" />
        <bpmn:sequenceFlow id="Flow_V5_1_2" sourceRef="Task_5_1" targetRef="Gateway_5_2" />
        <bpmn:sequenceFlow id="Flow_V5_2_3" name="Sí" sourceRef="Gateway_5_2" targetRef="Task_5_3" />
        <bpmn:sequenceFlow id="Flow_V5_2_4" name="No" sourceRef="Gateway_5_2" targetRef="Task_5_4" />
        <bpmn:sequenceFlow id="Flow_V5_4_5" sourceRef="Task_5_4" targetRef="Task_5_5" />
        <bpmn:sequenceFlow id="Flow_V5_3_m" sourceRef="Task_5_3" targetRef="Gateway_5_merge" />
        <bpmn:sequenceFlow id="Flow_V5_5_m" sourceRef="Task_5_5" targetRef="Gateway_5_merge" />
        <bpmn:sequenceFlow id="Flow_V5_m_e" sourceRef="Gateway_5_merge" targetRef="EndEvent_V5" />
      </bpmn:subProcess>
      <bpmn:subProcess id="SubProcess_V6" name="6. Verificar registros">
        <bpmn:documentation>Subproceso que se repite por cada fila de la ficha (multi-instancia secuencial). Al terminar todas las filas continúa con 7. Verificar riesgos.</bpmn:documentation>
        <bpmn:incoming>Flow_FaseB_to_V6</bpmn:incoming>
        <bpmn:outgoing>Flow_FaseB_to_V7</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics id="MI_SubProcess_V6" isSequential="true" />
        <bpmn:startEvent id="StartEvent_V6" name="Registro por verificar">
          <bpmn:outgoing>Flow_V6_s_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_6_1" name="6.1 Revisar registro en la ficha técnica">
          <bpmn:documentation>Revisar en la sección “Registros” el documento o registro indicado y verificar si es el que actualmente utiliza la oficina o unidad para el desarrollo de sus funciones.</bpmn:documentation>
          <bpmn:incoming>Flow_V6_s_1</bpmn:incoming>
          <bpmn:outgoing>Flow_V6_1_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_6_2" name="6.2 ¿Es el registro que se utiliza actualmente?">
          <bpmn:documentation>¿El documento o registro indicado en “Registros” es el que actualmente utiliza la oficina o unidad?</bpmn:documentation>
          <bpmn:incoming>Flow_V6_1_2</bpmn:incoming>
          <bpmn:outgoing>Flow_V6_2_3</bpmn:outgoing>
          <bpmn:outgoing>Flow_V6_2_4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_6_3" name="6.3 Marcar casilla SÍ">
          <bpmn:documentation>Marcar la casilla SÍ de la fila: el documento o registro indicado corresponde al que actualmente utiliza la oficina o unidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V6_2_3</bpmn:incoming>
          <bpmn:outgoing>Flow_V6_3_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_6_4" name="6.4 Marcar casilla NO">
          <bpmn:documentation>Marcar la casilla NO de la fila cuando el documento o registro no corresponda, ya no se utilice o tenga una denominación diferente.</bpmn:documentation>
          <bpmn:incoming>Flow_V6_2_4</bpmn:incoming>
          <bpmn:outgoing>Flow_V6_4_5</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_6_5" name="6.5 Registrar nombre correcto del registro">
          <bpmn:documentation>Registrar en la columna “Nombre correcto” la denominación actual y correcta del documento o registro que utiliza.</bpmn:documentation>
          <bpmn:incoming>Flow_V6_4_5</bpmn:incoming>
          <bpmn:outgoing>Flow_V6_5_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_6_merge">
          <bpmn:incoming>Flow_V6_3_m</bpmn:incoming>
          <bpmn:incoming>Flow_V6_5_m</bpmn:incoming>
          <bpmn:outgoing>Flow_V6_m_e</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_V6" name="Registro verificado">
          <bpmn:incoming>Flow_V6_m_e</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_V6_s_1" sourceRef="StartEvent_V6" targetRef="Task_6_1" />
        <bpmn:sequenceFlow id="Flow_V6_1_2" sourceRef="Task_6_1" targetRef="Gateway_6_2" />
        <bpmn:sequenceFlow id="Flow_V6_2_3" name="Sí" sourceRef="Gateway_6_2" targetRef="Task_6_3" />
        <bpmn:sequenceFlow id="Flow_V6_2_4" name="No" sourceRef="Gateway_6_2" targetRef="Task_6_4" />
        <bpmn:sequenceFlow id="Flow_V6_4_5" sourceRef="Task_6_4" targetRef="Task_6_5" />
        <bpmn:sequenceFlow id="Flow_V6_3_m" sourceRef="Task_6_3" targetRef="Gateway_6_merge" />
        <bpmn:sequenceFlow id="Flow_V6_5_m" sourceRef="Task_6_5" targetRef="Gateway_6_merge" />
        <bpmn:sequenceFlow id="Flow_V6_m_e" sourceRef="Gateway_6_merge" targetRef="EndEvent_V6" />
      </bpmn:subProcess>
      <bpmn:subProcess id="SubProcess_V7" name="7. Verificar riesgos">
        <bpmn:documentation>Subproceso que se repite por cada fila de la ficha (multi-instancia secuencial). Al terminar todas las filas continúa con 8. Verificar controles.</bpmn:documentation>
        <bpmn:incoming>Flow_FaseB_to_V7</bpmn:incoming>
        <bpmn:outgoing>Flow_FaseB_to_V8</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics id="MI_SubProcess_V7" isSequential="true" />
        <bpmn:startEvent id="StartEvent_V7" name="Riesgo por verificar">
          <bpmn:outgoing>Flow_V7_s_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_7_1" name="7.1 Revisar riesgo en la ficha técnica">
          <bpmn:documentation>Revisar en la sección “Riesgos” el riesgo indicado y verificar si se presenta actualmente en la oficina o unidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V7_s_1</bpmn:incoming>
          <bpmn:outgoing>Flow_V7_1_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_7_2" name="7.2 ¿El riesgo se presenta actualmente?">
          <bpmn:documentation>¿El riesgo indicado se presenta actualmente en la oficina o unidad?</bpmn:documentation>
          <bpmn:incoming>Flow_V7_1_2</bpmn:incoming>
          <bpmn:outgoing>Flow_V7_2_3</bpmn:outgoing>
          <bpmn:outgoing>Flow_V7_2_6</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_7_3" name="7.3 Marcar casilla SÍ">
          <bpmn:documentation>Marcar la casilla SÍ, confirmando que el riesgo indicado se presenta actualmente en la oficina o unidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V7_2_3</bpmn:incoming>
          <bpmn:outgoing>Flow_V7_3_4</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_7_4" name="7.4 ¿Está descrito de forma diferente?">
          <bpmn:documentation>¿El riesgo existe, pero está descrito de forma diferente en la ficha?</bpmn:documentation>
          <bpmn:incoming>Flow_V7_3_4</bpmn:incoming>
          <bpmn:outgoing>Flow_V7_4_5</bpmn:outgoing>
          <bpmn:outgoing>Flow_V7_4_m</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_7_5" name="7.5 Registrar descripción actual del riesgo">
          <bpmn:documentation>Indicar en la columna “Nombre correcto” la descripción actual del riesgo.</bpmn:documentation>
          <bpmn:incoming>Flow_V7_4_5</bpmn:incoming>
          <bpmn:outgoing>Flow_V7_5_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_7_6" name="7.6 Marcar casilla NO">
          <bpmn:documentation>Marcar la casilla NO cuando el riesgo indicado no se presenta actualmente en la oficina o unidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V7_2_6</bpmn:incoming>
          <bpmn:outgoing>Flow_V7_6_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_7_merge">
          <bpmn:incoming>Flow_V7_4_m</bpmn:incoming>
          <bpmn:incoming>Flow_V7_5_m</bpmn:incoming>
          <bpmn:incoming>Flow_V7_6_m</bpmn:incoming>
          <bpmn:outgoing>Flow_V7_m_e</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_V7" name="Riesgo verificado">
          <bpmn:incoming>Flow_V7_m_e</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_V7_s_1" sourceRef="StartEvent_V7" targetRef="Task_7_1" />
        <bpmn:sequenceFlow id="Flow_V7_1_2" sourceRef="Task_7_1" targetRef="Gateway_7_2" />
        <bpmn:sequenceFlow id="Flow_V7_2_3" name="Sí" sourceRef="Gateway_7_2" targetRef="Task_7_3" />
        <bpmn:sequenceFlow id="Flow_V7_2_6" name="No" sourceRef="Gateway_7_2" targetRef="Task_7_6" />
        <bpmn:sequenceFlow id="Flow_V7_3_4" sourceRef="Task_7_3" targetRef="Gateway_7_4" />
        <bpmn:sequenceFlow id="Flow_V7_4_5" name="Sí" sourceRef="Gateway_7_4" targetRef="Task_7_5" />
        <bpmn:sequenceFlow id="Flow_V7_4_m" name="No" sourceRef="Gateway_7_4" targetRef="Gateway_7_merge" />
        <bpmn:sequenceFlow id="Flow_V7_5_m" sourceRef="Task_7_5" targetRef="Gateway_7_merge" />
        <bpmn:sequenceFlow id="Flow_V7_6_m" sourceRef="Task_7_6" targetRef="Gateway_7_merge" />
        <bpmn:sequenceFlow id="Flow_V7_m_e" sourceRef="Gateway_7_merge" targetRef="EndEvent_V7" />
      </bpmn:subProcess>
      <bpmn:subProcess id="SubProcess_V8" name="8. Verificar controles">
        <bpmn:documentation>Subproceso que se repite por cada fila de la ficha (multi-instancia secuencial). Al terminar todas las filas continúa con 9. Completar datos del jefe en la formalización.</bpmn:documentation>
        <bpmn:incoming>Flow_FaseB_to_V8</bpmn:incoming>
        <bpmn:outgoing>Flow_FaseB_end</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics id="MI_SubProcess_V8" isSequential="true" />
        <bpmn:startEvent id="StartEvent_V8" name="Control por verificar">
          <bpmn:outgoing>Flow_V8_s_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_8_1" name="8.1 Revisar control en la ficha técnica">
          <bpmn:documentation>Revisar en la sección “Controles” el control indicado y verificar si se aplica actualmente en la oficina o unidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V8_s_1</bpmn:incoming>
          <bpmn:outgoing>Flow_V8_1_2</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_8_2" name="8.2 ¿El control se aplica actualmente?">
          <bpmn:documentation>¿El control indicado se aplica actualmente en la oficina o unidad?</bpmn:documentation>
          <bpmn:incoming>Flow_V8_1_2</bpmn:incoming>
          <bpmn:outgoing>Flow_V8_2_3</bpmn:outgoing>
          <bpmn:outgoing>Flow_V8_2_6</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_8_3" name="8.3 Marcar casilla SÍ">
          <bpmn:documentation>Marcar la casilla SÍ: el control indicado se aplica actualmente en la oficina o unidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V8_2_3</bpmn:incoming>
          <bpmn:outgoing>Flow_V8_3_4</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_8_4" name="8.4 ¿Se aplica de otra manera o con otro nombre?">
          <bpmn:documentation>¿El control se aplica, pero se realiza de otra manera o tiene una denominación diferente?</bpmn:documentation>
          <bpmn:incoming>Flow_V8_3_4</bpmn:incoming>
          <bpmn:outgoing>Flow_V8_4_5</bpmn:outgoing>
          <bpmn:outgoing>Flow_V8_4_m</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_8_5" name="8.5 Registrar descripción actual del control">
          <bpmn:documentation>Indicar en la columna “Nombre correcto” la descripción o denominación actual del control.</bpmn:documentation>
          <bpmn:incoming>Flow_V8_4_5</bpmn:incoming>
          <bpmn:outgoing>Flow_V8_5_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_8_6" name="8.6 Marcar casilla NO">
          <bpmn:documentation>Marcar la casilla NO cuando el control indicado no se aplica actualmente en la oficina o unidad.</bpmn:documentation>
          <bpmn:incoming>Flow_V8_2_6</bpmn:incoming>
          <bpmn:outgoing>Flow_V8_6_m</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_8_merge">
          <bpmn:incoming>Flow_V8_4_m</bpmn:incoming>
          <bpmn:incoming>Flow_V8_5_m</bpmn:incoming>
          <bpmn:incoming>Flow_V8_6_m</bpmn:incoming>
          <bpmn:outgoing>Flow_V8_m_e</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_V8" name="Control verificado">
          <bpmn:incoming>Flow_V8_m_e</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_V8_s_1" sourceRef="StartEvent_V8" targetRef="Task_8_1" />
        <bpmn:sequenceFlow id="Flow_V8_1_2" sourceRef="Task_8_1" targetRef="Gateway_8_2" />
        <bpmn:sequenceFlow id="Flow_V8_2_3" name="Sí" sourceRef="Gateway_8_2" targetRef="Task_8_3" />
        <bpmn:sequenceFlow id="Flow_V8_2_6" name="No" sourceRef="Gateway_8_2" targetRef="Task_8_6" />
        <bpmn:sequenceFlow id="Flow_V8_3_4" sourceRef="Task_8_3" targetRef="Gateway_8_4" />
        <bpmn:sequenceFlow id="Flow_V8_4_5" name="Sí" sourceRef="Gateway_8_4" targetRef="Task_8_5" />
        <bpmn:sequenceFlow id="Flow_V8_4_m" name="No" sourceRef="Gateway_8_4" targetRef="Gateway_8_merge" />
        <bpmn:sequenceFlow id="Flow_V8_5_m" sourceRef="Task_8_5" targetRef="Gateway_8_merge" />
        <bpmn:sequenceFlow id="Flow_V8_6_m" sourceRef="Task_8_6" targetRef="Gateway_8_merge" />
        <bpmn:sequenceFlow id="Flow_V8_m_e" sourceRef="Gateway_8_merge" targetRef="EndEvent_V8" />
      </bpmn:subProcess>
      <bpmn:endEvent id="EndEvent_FaseB" name="Ejecución del proceso verificada">
        <bpmn:incoming>Flow_FaseB_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_FaseB_to_V5" sourceRef="StartEvent_FaseB" targetRef="SubProcess_V5" />
      <bpmn:sequenceFlow id="Flow_FaseB_to_V6" sourceRef="SubProcess_V5" targetRef="SubProcess_V6" />
      <bpmn:sequenceFlow id="Flow_FaseB_to_V7" sourceRef="SubProcess_V6" targetRef="SubProcess_V7" />
      <bpmn:sequenceFlow id="Flow_FaseB_to_V8" sourceRef="SubProcess_V7" targetRef="SubProcess_V8" />
      <bpmn:sequenceFlow id="Flow_FaseB_end" sourceRef="SubProcess_V8" targetRef="EndEvent_FaseB" />
    </bpmn:subProcess>
    <bpmn:task id="Task_9" name="9. Completar datos del jefe en la formalización">
      <bpmn:documentation>Completar el espacio en blanco (original) de la sección “Formalización del proceso” con los datos del jefe de la unidad, oficina o escuela encargada.</bpmn:documentation>
      <bpmn:incoming>Flow_Main_B_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_9_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_10" name="10. Exportar ficha técnica a PDF">
      <bpmn:documentation>Una vez culminado el llenado, exportar a PDF el documento Excel de la ficha técnica para la firma digital del jefe encargado.</bpmn:documentation>
      <bpmn:incoming>Flow_Main_9_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_10_e</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Main" name="Ficha técnica exportada para firma digital">
      <bpmn:incoming>Flow_Main_10_e</bpmn:incoming>
    </bpmn:endEvent>
